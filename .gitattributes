# Normaliza finais de linha. Scripts e arquivos executados em Linux/CI ficam sempre com LF.
* text=auto

*.sh text eol=lf
Dockerfile text eol=lf
*.dockerignore text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf
*.json text eol=lf
*.js text eol=lf
*.md text eol=lf

# Binários
*.pdf binary
*.png binary
*.jpg binary
