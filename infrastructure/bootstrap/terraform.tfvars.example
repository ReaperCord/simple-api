# Copie para secrets.tfvars (ignorado pelo git) e troque os placeholders.
# Uso: terraform apply -var-file=secrets.tfvars  (apply so com aprovacao explicita do Leandro)
project_name = "simple-api"
environment  = "dev"
region       = "us-east-1"
owner        = "leandro"
ttl          = "none"

github_owner = "<GITHUB_OWNER>"
github_repo  = "simple-api"
# IDs numericos do owner e do repo (claims repository_owner_id e repository_id do OIDC).
# Publicos: gh api users/<owner> --jq .id  e  gh api repos/<owner>/<repo> --jq .id
github_owner_id = "<GITHUB_OWNER_ID>"
github_repo_id  = "<GITHUB_REPO_ID>"

budget_emails = ["<EMAIL>"]

# [PROPOSTA] a calibrar
ecr_max_image_count = 10
