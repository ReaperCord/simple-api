{
  "ingress": [
    {
      "rule_key": "from-vpclink-3000",
      "description": "Allow application traffic from VPC Link only",
      "from_port": 3000,
      "to_port": 3000,
      "protocol": "tcp",
      "sg_refs": ["vpclink"]
    }
  ],
  "egress": [
    {
      "rule_key": "https-443",
      "description": "Allow HTTPS outbound for container image pulls and AWS API calls",
      "from_port": 443,
      "to_port": 443,
      "protocol": "tcp",
      "cidr_blocks": ["0.0.0.0/0"]
    },
    {
      "rule_key": "dns-udp-53",
      "description": "Allow DNS resolution (UDP)",
      "from_port": 53,
      "to_port": 53,
      "protocol": "udp",
      "cidr_blocks": ["0.0.0.0/0"]
    },
    {
      "rule_key": "dns-tcp-53",
      "description": "Allow DNS resolution (TCP)",
      "from_port": 53,
      "to_port": 53,
      "protocol": "tcp",
      "cidr_blocks": ["0.0.0.0/0"]
    },
    {
      "rule_key": "to-rds-5432",
      "description": "Allow PostgreSQL to RDS",
      "from_port": 5432,
      "to_port": 5432,
      "protocol": "tcp",
      "sg_refs": ["rds"]
    }
  ]
}
