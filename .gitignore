# ---------------------------------------------------------------
# .gitignore da raiz (KXC simple-api)
# application/ e infrastructure/ mantêm seus próprios .gitignore.
# Esta lista é a rede de segurança para o repositório inteiro.
# ---------------------------------------------------------------

# Segredos e credenciais (nunca versionar)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
credentials.json
secrets.tfvars
.aws/

# Terraform (qualquer pasta: bootstrap, eks-lab, módulos)
# O .terraform.lock.hcl FICA versionado (reprodutibilidade dos providers).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
*.auto.tfvars
*.auto.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.nyc_output/
*.tgz

# Build e saídas locais
dist/
build/
*.log
*.pid
tmp/
.tmp/

# Testes de carga: os CSV/TXT de tests/load/results/ SÃO evidência e ficam versionados.
# Ignora só saídas temporárias do k6 e do driver.
tests/load/**/*.tmp
tests/load/**/summary-*.json
tests/load/**/k6-out*

# Kiro / agentes
# .kiro/steering, .kiro/agents, .kiro/prompts e .kiro/specs ficam versionados.
# Configuração local de MCP e estado de sessão não.
.kiro/settings/
.kiro/sandbox-state/
.kiro/workspace-roots/
# Relatórios de trabalho de workflows (artefatos efêmeros; use git add -f para guardar um)
.agents/

# Editores
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini
